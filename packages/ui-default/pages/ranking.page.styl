.page--ranking, .page--homepage
  .col--rank
    width: rem(65px)
    position: relative

  .col--user
    width: rem(300px)

  .col--rp
    width: rem(60px)
    text-align: right

  .col--detail
    width: rem(50px)
    text-align: center
  
  &[lang="en"]
    .col--detail
      width: rem(75px)

  .col--ac
    width: rem(50px)
    text-align: center
  
  &[lang="en"]
    .col--ac
      width: rem(70px)

  .col--bio
    display: block;

  td.col--bio
    height: 36px !important;

  +mobile()
    .col--bio
      display: none

.page--homepage
  +mobile()
    .col--detail
      display: none

.page--ranking
  .ranking-row
    width: 100%
    max-width: none

  .ranking-grades
    display: flex
    flex-wrap: wrap
    gap: rem(4px) rem(12px)
    margin-bottom: rem(12px)

    a
      padding: rem(4px) rem(6px)

    a[aria-current="page"]
      font-weight: bold
      text-decoration: underline

  .ranking-table-scroll
    max-width: 100%
    overflow-x: auto

    &:focus-visible
      outline: 2px solid $primary-color
      outline-offset: -2px

  .ranking-external-scope
    display: flex
    flex-wrap: wrap
    gap: rem(8px) rem(16px)
    margin-top: rem(8px)

    a[aria-current="page"]
      font-weight: bold
      text-decoration: underline

  .ranking-rp-table
    width: 100%

    th, td
      padding-left: rem(7px)
      padding-right: rem(7px)
      overflow: visible
      text-overflow: clip
      white-space: nowrap

    .col--user
      white-space: normal
      overflow-wrap: anywhere

    .col--rank
      font-variant-numeric: tabular-nums

  .ranking-rp-table
    min-width: rem(960px)
    table-layout: auto

    .col--rank
      width: rem(46px)

    .col--user
      width: auto
      min-width: rem(180px)

    .col--rp, .col--detail, .col--ac
      width: rem(50px)

    .col--external
      width: rem(60px)
      text-align: right

    .col--external-codeforces
      width: rem(108px)

    .col--external-atcoder
      width: rem(88px)

    .col--external-total, .col--daily
      width: rem(88px)
      text-align: right

    th[aria-sort="descending"] .ranking-sort-link
      font-weight: bold
      text-decoration: underline

  .ranking-stale, .ranking-partial
    display: inline-block
    margin-left: rem(2px)
    font-weight: bold

  .ranking-note
    padding: rem(8px) rem(12px)
    font-size: rem(12px)
    line-height: 1.6
    color: $text-2-color

    p + p
      margin-top: rem(4px)

  .ranking-pending
    color: $text-2-color
